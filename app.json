{
  "expo": {
    "name": "FitVerse",
    "slug": "FitVerse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitverse",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ngafney07.FitVerse",
      "appleTeamId": "JXT3D7Y4U3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "FitVerse uses the camera so you can scan a meal to log it and add photos to your workout posts.",
        "NSPhotoLibraryUsageDescription": "FitVerse needs access to your photos so you can set a profile picture and attach images to posts.",
        "NSPhotoLibraryAddUsageDescription": "FitVerse saves images you create in the app back to your photo library.",
        "NSContactsUsageDescription": "FitVerse can check your contacts to suggest friends who already use the app. Your contacts are never uploaded.",
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      "react-native-bottom-tabs",
      "expo-notifications",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c22bee0-de27-48e9-a6b2-4a5d9e744d44"
      }
    }
  }
}
